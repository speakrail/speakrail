# Copy to .env and edit. `docker compose up` reads it.
# Everything is optional except where noted.

# --- Models ---------------------------------------------------------------
# Hugging Face token, only needed if a model repo asks you to accept its terms
# before downloading. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=
# Where weights are stored on the host (shared by all services)
MODELS_DIR=./models

# --- Images ---------------------------------------------------------------
# Version of the speakrail images on Docker Hub
SPEAKRAIL_VERSION=0.1.0
# Only for `docker compose up --build`: GPU generations the speech recognizer is
# compiled for. The list in engines/asr/audiocpp/Dockerfile explains the numbers; fewer builds faster.
ASR_CUDA_ARCHS=75-real;80-real;80-virtual;86-real;89-real;90-real;100-real;120a-real;121a-real

# --- GPU ------------------------------------------------------------------
# Which GPU to use. Speakrail needs one 24 GB card (tested on an RTX 4090).
CUDA_VISIBLE_DEVICES=0
# Share of GPU memory for the LLM. ASR (~6.5 GiB) and TTS (~5.2 GiB) take the
# rest. Lower it if the same card also drives your display.
LLM_GPU_MEMORY_UTILIZATION=0.48
# LLM context length in tokens
LLM_MAX_MODEL_LEN=16384

# --- Web UI ---------------------------------------------------------------
# Browsers allow the microphone only on localhost or over HTTPS. For a remote
# GPU box, use an SSH tunnel: ssh -L 8080:localhost:8080 <host>
UI_HOST=127.0.0.1
UI_PORT=8080

# --- Assistant ------------------------------------------------------------
# Persona and voice: a reference clip in src/speakrail/harness/voices/ with its transcript next to it (female_a.txt).
# The default voice was designed with Breeze TTS 2 (no real speaker).
PERSONA=nova
VOICE=female_a.wav
# "Home" for the weather and time tools
HOME_CITY=London
HOME_TIMEZONE=Europe/London

# --- Turn taking ----------------------------------------------------------
# Silence fallback that ends a turn in ms (0 = only the turn head ends turns)
SILENCE_MS=1000
# Listening notes: the base model takes notes while you speak (better answers,
# about +0.8 s on long questions)
NOTES=1
# Interjections: short remarks while you keep talking (counting, tallies)
INTERJECT=1

# --- Web search -----------------------------------------------------------
# off (default), searxng (local container: also start it with `docker compose --profile search up -d`),
# serper or brave (with their API key)
SEARCH=off
SEARXNG_SECRET=change-me
BRAVE_API_KEY=
SERPER_API_KEY=

# --- Optional paid tools (off when the key is empty) ----------------------
# ask_frontier: hands hard questions to a larger model on Fireworks
FIREWORKS_API_KEY=

# --- Privacy ---------------------------------------------------------------
# Save every session (event log, the full context and an audio recording of both
# sides) under the app-data volume. Off by default.
# SESSIONS_DIR=/data/sessions
